# Copy to agent.env and fill in. Never commit agent.env.
TRACKER_URL=https://YOUR-WORKER.YOUR-NAME.workers.dev
AGENT_TOKEN=same-long-random-string-as-the-worker-secret
OUT_DIR=/opt/yt-agent/downloads
POLL_SECONDS=300
YTDLP_COOKIES=/opt/yt-agent/cookies.txt
VIDEO_RES=1080
AGE_LIMIT=17
# Optional R2 (Cloudflare → R2 → Manage API tokens):
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=yt-files
